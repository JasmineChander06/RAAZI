rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true
        || request.auth.token.firebase.sign_in_provider == 'password'
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'solvedCount', 'totalCases', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'displayName', 'solvedCount', 'totalCases',
          'unlockedStage', 'completedStageIds', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.solvedCount is int && data.solvedCount >= 0 && data.solvedCount <= 100000
        && data.totalCases is int && data.totalCases >= 0 && data.totalCases <= 100000
        && (!('unlockedStage' in data) || (data.unlockedStage is int && data.unlockedStage >= 1 && data.unlockedStage <= 10))
        && (!('completedStageIds' in data) || (
          data.completedStageIds is list
          && data.completedStageIds.size() <= 12
          && (data.completedStageIds.size() == 0 || data.completedStageIds[0] is string)
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.updatedAt is timestamp;
    }

    function isValidDetectiveCase(data) {
      return data.keys().hasAll([
          'ownerId', 'title', 'era', 'difficulty', 'synopsis', 'settingDetail',
          'status', 'suspects', 'culpritId', 'solutionSummary', 'clueCount',
          'turnCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'title', 'era', 'difficulty', 'synopsis', 'settingDetail',
          'status', 'suspects', 'culpritId', 'solutionSummary', 'accusedSuspectId',
          'solvedCorrectly', 'stageId', 'stageOrder', 'clueCount', 'turnCount',
          'candidateQuestions', 'bannerImageUrl', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && data.era is string && data.era.size() >= 2 && data.era.size() <= 80
        && data.difficulty in ['Novice', 'Adept', 'Master']
        && data.synopsis is string && data.synopsis.size() >= 10 && data.synopsis.size() <= 2400
        && data.settingDetail is string && data.settingDetail.size() >= 2 && data.settingDetail.size() <= 800
        && data.status in ['active', 'solved', 'closed']
        && data.suspects is list && data.suspects.size() >= 2 && data.suspects.size() <= 8
        && data.suspects[0] is map
        && isValidId(data.culpritId) && data.culpritId.size() <= 64
        && data.solutionSummary is string && data.solutionSummary.size() >= 10 && data.solutionSummary.size() <= 2000
        && (!('accusedSuspectId' in data) || (data.accusedSuspectId is string && data.accusedSuspectId.size() <= 64))
        && (!('solvedCorrectly' in data) || data.solvedCorrectly is bool)
        && (!('stageId' in data) || (data.stageId is string && data.stageId.size() <= 64))
        && (!('stageOrder' in data) || (data.stageOrder is int && data.stageOrder >= 1 && data.stageOrder <= 10))
        && (!('candidateQuestions' in data) || (data.candidateQuestions is list && data.candidateQuestions.size() <= 12))
        && (!('bannerImageUrl' in data) || (data.bannerImageUrl is string && data.bannerImageUrl.size() <= 300))
        && data.clueCount is int && data.clueCount >= 0 && data.clueCount <= 500
        && data.turnCount is int && data.turnCount >= 0 && data.turnCount <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClueNode(data, caseId) {
      return data.keys().hasAll([
          'ownerId', 'caseId', 'title', 'detail', 'category', 'source',
          'discovered', 'connectedNodeIds', 'likelihoods', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'caseId', 'title', 'detail', 'category', 'source',
          'discovered', 'connectedNodeIds', 'likelihoods', 'createdAt'
        ])
        && isValidId(data.ownerId)
        && isValidId(data.caseId) && data.caseId == caseId
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.detail is string && data.detail.size() >= 4 && data.detail.size() <= 1200
        && data.category in ['physical', 'testimony', 'alibi', 'cipher', 'location']
        && data.source in ['initial', 'discovered', 'user_submitted']
        && data.discovered is bool
        && data.connectedNodeIds is list && data.connectedNodeIds.size() <= 12
        && (data.connectedNodeIds.size() == 0 || data.connectedNodeIds[0] is string)
        && data.likelihoods is map
        && data.createdAt is timestamp;
    }

    function isValidInvestigationTurn(data, caseId) {
      return data.keys().hasAll(['ownerId', 'caseId', 'role', 'content', 'createdAt'])
        && data.keys().hasOnly([
          'ownerId', 'caseId', 'role', 'content', 'nlpIntent',
          'topSuspectName', 'topProbability', 'createdAt'
        ])
        && isValidId(data.ownerId)
        && isValidId(data.caseId) && data.caseId == caseId
        && data.role in ['investigator', 'raazi']
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 4000
        && (!('nlpIntent' in data) || (data.nlpIntent is string && data.nlpIntent.size() <= 120))
        && (!('topSuspectName' in data) || (data.topSuspectName is string && data.topSuspectName.size() <= 120))
        && (!('topProbability' in data) || data.topProbability is number)
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerified() && isValidId(userId) && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId) && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'solvedCount', 'totalCases', 'unlockedStage', 'completedStageIds', 'updatedAt'
        ]);
      allow delete: if false;

      match /private/{docId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(docId) && request.auth.uid == userId;
        allow list: if false;
        allow create: if isVerified() && isValidId(userId) && isValidId(docId) && request.auth.uid == userId
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == userId
          && incoming().updatedAt == request.time;
        allow update: if isVerified() && isValidId(userId) && isValidId(docId) && request.auth.uid == userId
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if false;
      }
    }

    match /cases/{caseId} {
      allow get: if isSignedIn() && isValidId(caseId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(caseId)
        && isValidDetectiveCase(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(caseId)
        && existing().ownerId == request.auth.uid
        && existing().status == 'active'
        && isValidDetectiveCase(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().culpritId == existing().culpritId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (incoming().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly(['suspects', 'clueCount', 'turnCount', 'candidateQuestions', 'updatedAt']))
          || ((incoming().status == 'solved' || incoming().status == 'closed')
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'accusedSuspectId', 'solvedCorrectly', 'updatedAt']))
        );
      allow delete: if isVerified() && isValidId(caseId) && existing().ownerId == request.auth.uid;

      match /clues/{clueId} {
        allow get: if isSignedIn() && isValidId(caseId) && isValidId(clueId)
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/cases/$(caseId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow create: if isVerified() && isValidId(caseId) && isValidId(clueId)
          && isValidClueNode(incoming(), caseId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/cases/$(caseId))
          && getAfter(/databases/$(database)/documents/cases/$(caseId)).data.ownerId == request.auth.uid
          && getAfter(/databases/$(database)/documents/cases/$(caseId)).data.status == 'active';
        allow update: if isVerified() && isValidId(caseId) && isValidId(clueId)
          && existing().ownerId == request.auth.uid
          && isValidClueNode(incoming(), caseId)
          && incoming().ownerId == existing().ownerId
          && incoming().caseId == existing().caseId
          && incoming().createdAt == existing().createdAt
          && get(/databases/$(database)/documents/cases/$(caseId)).data.ownerId == request.auth.uid
          && get(/databases/$(database)/documents/cases/$(caseId)).data.status == 'active'
          && incoming().diff(existing()).affectedKeys().hasOnly(['discovered', 'connectedNodeIds']);
        allow delete: if isVerified() && isValidId(caseId) && isValidId(clueId)
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/cases/$(caseId)).data.ownerId == request.auth.uid;
      }

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(caseId) && isValidId(messageId)
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/cases/$(caseId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow create: if isVerified() && isValidId(caseId) && isValidId(messageId)
          && isValidInvestigationTurn(incoming(), caseId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/cases/$(caseId))
          && getAfter(/databases/$(database)/documents/cases/$(caseId)).data.ownerId == request.auth.uid;
        allow update: if false;
        allow delete: if isVerified() && isValidId(caseId) && isValidId(messageId)
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/cases/$(caseId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
